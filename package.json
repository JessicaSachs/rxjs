{
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/rxjs.dev"
    ],
    "nohoist": [
      "**/@types/jasmine",
      "**/@types/jasminewd2",
      "**/@types/mocha",
      "**/core-js"
    ]
  },
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": "^18.13.0 || ^20.9.0"
  },
  "packageManager": "yarn@1.22.21",
  "scripts": {
    "prepare-packages": "yarn nx test @rxjs/observable && yarn nx run-many -t build,lint,test:circular,dtslint,copy_common_package_files --exclude rxjs.dev",
    "test:wpt": "tsx tests/wpt.mts",
    "test:e2e": "wdio run wdio.conf.ts",
    "test:basic": "cross-env NODE_ENV=local concurrently \"http-server . -p 8080\" \"wdio run wdio.local.conf.ts\"",
    "release": "node scripts/release.js",
    "postinstall": "npm update browserstack-node-sdk",
    "test-browserstack": "browserstack-node-sdk node tests/foo.cjs"
  },
  "devDependencies": {
    "@nx/eslint-plugin": "17.3.2",
    "@nx/js": "17.3.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.5",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@wdio/browserstack-service": "^8.32.3",
    "@wdio/cli": "^8.32.3",
    "@wdio/globals": "^9.9.3",
    "@wdio/local-runner": "^8.32.3",
    "@wdio/mocha-framework": "^8.32.3",
    "@wdio/spec-reporter": "^8.32.2",
    "@wdio/types": "^8.32.3",
    "browserslist": "^4.24.4",
    "browserstack-local": "^1.5.6",
    "browserstack-node-sdk": "^1.34.40",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "cz-conventional-changelog": "1.2.0",
    "dotenv": "^16.4.7",
    "eslint": "^8.56.0",
    "http-server": "^14.1.1",
    "husky": "^4.2.5",
    "lint-staged": "^10.2.11",
    "liquidjs": "^10.20.3",
    "nx": "17.3.2",
    "selenium-webdriver": "^4.29.0",
    "ts-node": "^10.9.2",
    "tshy": "^1.11.0",
    "tsx": "^4.19.3",
    "typescript": "~5.3.3",
    "validate-commit-msg": "2.14.0",
    "vitest": "^1.2.1"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "validate-commit-msg"
    }
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.js": "eslint --cache --fix",
    "(src|spec)/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,css,md}": "prettier --write"
  }
}
